{
  "expo": {
    "name": "Fantasy F1 2026",
    "slug": "fantasy-f1-2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "fantasyf1",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fantasyf1.app"
    },
    "android": {
      "package": "com.fantasyf1.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F"
      }
    },
    "plugins": [
      "expo-router",
      "react-native-gesture-handler"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
